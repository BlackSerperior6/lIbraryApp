@page
@model LibraryAppWeb.Pages.View.ReaderModel
<div class="view-reader-form">
    <h2>Просмотр читателя</h2>

    <div class="form-group">
        <label>Фамилия</label>
        <input asp-for="LastName" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label>Имя</label>
        <input asp-for="FirstName" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label>Отчество</label>
        <input asp-for="Patronymic" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label>Дата выдачи билета</label>
        <input asp-for="IssuedDate" type="datetime-local" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label>Дата рождения читателя</label>
        <input asp-for="Birthday" type="datetime-local" class="form-control" readonly />
    </div>
    <li class="nav-item">
        <a class="btn btn-primary" asp-area="" asp-page="/ControlPanel">Вернуться</a>
    </li>
</div>
