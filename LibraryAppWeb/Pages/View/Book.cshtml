@page
@model LibraryAppWeb.Pages.View.BookModel
<div class="view-book-form">
    <h2>Просмотр данных о книге</h2>

    <div class="form-group">
            <label>Название</label>
            <input asp-for="Title" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label>Автор</label>
            <input asp-for="Author" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label>Дата поступления</label>
            <input asp-for="ArrivalDate" type="datetime-local" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label>Дата выпуска</label>
            <input asp-for="ReleasedDate" type="datetime-local" class="form-control" readonly />
        </div>
        <li class="nav-item">
            <a class="btn btn-primary" asp-area="" asp-page="/ControlPanel">Вернуться</a>
        </li>
</div>
