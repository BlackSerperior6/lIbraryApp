@page
@model LibraryAppWeb.Pages.ViewAll.UserModel
<div class="viewall-user-form">
    <h2>Просмотр списка пользователей</h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID пользователя</th>
                <th>Логин</th>
                <th>Роль</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pair in Model.Users)
            {
                <tr>
                    <td>@pair.Key</td>
                    <td>@pair.Value.Login</td>
                    <td>@pair.Value.Role</td>
                </tr>
            }
        </tbody>
    </table>
</div>
