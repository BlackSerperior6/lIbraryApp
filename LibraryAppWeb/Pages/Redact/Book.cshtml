@page
@model LibraryAppWeb.Pages.Redact.BookModel
<div class="redact-book-form">
    <h2>Редактирование книги</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="form-group">
            <label>Название</label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="form-group">
            <label>Автор</label>
            <input asp-for="Author" class="form-control" />
        </div>
        <div class="form-group">
            <label>Дата поступления</label>
            <input asp-for="ArrivalDate" type="datetime-local" class="form-control" />
        </div>
        <div class="form-group">
            <label>Дата выпуска</label>
            <input asp-for="ReleasedDate" type="datetime-local" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Закончить редактирование</button>
    </form>
</div>
